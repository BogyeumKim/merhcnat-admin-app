# Copy to .env.development / .env.production. Values are public: never put secrets in EXPO_PUBLIC_* variables.
# Local server: http://localhost:8080 (Android emulator: rewritten to 10.0.2.2 in dev; physical device: the PC's LAN IP).
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid
# Dev only. 1 = use the in-app mock for auth API responses.
EXPO_PUBLIC_API_MOCK=0
# Dev only. 1 = show fixture notices as the sign-in popup.
EXPO_PUBLIC_NOTICE_MOCK=0
